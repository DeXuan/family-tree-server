# 家族族谱管理系统 - 环境变量模板
# 复制为 .env 后按需修改；.env 不会提交到 git

# --- 数据库（二选一） ---
# 默认：内嵌 PGlite，零安装，数据落在 ./data/pgdata（推荐本地/家庭 NAS 自托管）
# 注意：PGlite 为单写者，只能单进程/单实例运行，勿使用 PM2 cluster
DATABASE_URL=pglite:./data/pgdata
# 生产：标准 PostgreSQL（云数据库或独立实例），取消下行注释并填入连接串
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/family_tree

# --- JWT ---
# 用于签发/校验登录令牌，务必替换为 32+ 位随机字符串
JWT_SECRET=change-me-to-a-long-random-string

# --- 服务器 ---
PORT=3000

# --- 备份目录 ---
# 每日自动备份输出位置（阶段2 启用）
BACKUP_DIR=./backups

# --- 首次运行空库自动播种 ---
# true：空库时自动创建演示谱系与 admin/admin123 账户；false：不播种
SEED_ON_EMPTY=true

# --- 登录限速 ---
# 同一 IP 在 10 分钟内允许的“失败”登录次数（成功登录不计数）
LOGIN_RATE_LIMIT_MAX=20

# --- 敏感字段加密（L2 联系方式） ---
# 32 字节 base64，可用：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 未配置时由 JWT_SECRET 派生；一旦有数据后请勿更换，否则旧密文无法解密
# DATA_ENCRYPTION_KEY=

# --- 家族标识 ---
# 单家族部署可保持默认；迁移到新家族时修改此处（需同时迁移数据）
# FAMILY_ID=00000000-0000-0000-0000-000000000001

# --- 媒体存储 ---
# 上传文件目录（默认 ./uploads）；备份 JSON 不含媒体文件，请单独备份此目录
# UPLOAD_DIR=./uploads

# --- 备份调度 ---
# 自动备份间隔（小时，0=关闭，默认关闭）；保留份数
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# --- 服务端 PDF（可选）---
# 生成 PDF 需要 Chromium：npx playwright install chromium
# 或指定系统浏览器路径
# CHROMIUM_PATH=/usr/bin/chromium-browser

# --- 旧谱 OCR（可选）---
# 兼容常见 tesseract-server / PaddleOCR HTTP 接口（POST multipart: file）
# OCR_ENDPOINT=https://your-ocr-server/ocr
# OCR_API_KEY=
# OCR_TIMEOUT_MS=30000

# --- 地图瓦片（可选）---
# 留空 = 纯离线自绘示意图（默认，隐私友好）
# 填 XYZ 模板即启用真实底图，CSP 会自动放行该域名
# MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_TILE_MAX_ZOOM=18
